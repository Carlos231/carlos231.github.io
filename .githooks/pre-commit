#!/usr/bin/env bash
# To activate: git config core.hooksPath .githooks

set -euo pipefail

PASS=true
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

red()    { printf "\033[31m%s\033[0m\n" "$*"; }
yellow() { printf "\033[33m%s\033[0m\n" "$*"; }
green()  { printf "\033[32m%s\033[0m\n" "$*"; }

# 1. No .DS_Store files
if echo "$STAGED" | grep -q '\.DS_Store'; then
    red "✖  .DS_Store file(s) staged — remove before committing."
    PASS=false
fi

# 2. No merge conflict markers
while IFS= read -r f; do
    [ -f "$f" ] || continue
    if grep -qE '^(<{7}|={7}|>{7})' "$f"; then
        red "✖  Merge conflict markers in: $f"
        PASS=false
    fi
done <<< "$STAGED"

# 3. HTML files must have <!DOCTYPE html> (except includes and verification files)
while IFS= read -r f; do
    [[ "$f" == *.html ]] || continue
    [[ "$f" == _includes/* || "$(basename "$f")" == google*.html ]] && continue
    [ -f "$f" ] || continue
    if ! grep -qi '<!DOCTYPE html>' "$f"; then
        red "✖  Missing <!DOCTYPE html> in: $f"
        PASS=false
    fi
done <<< "$STAGED"

# 4. sitemap.xml must be well-formed XML
if echo "$STAGED" | grep -q 'sitemap\.xml'; then
    if command -v xmllint &>/dev/null; then
        if ! xmllint --noout sitemap.xml 2>/dev/null; then
            red "✖  sitemap.xml is not valid XML."
            PASS=false
        fi
    fi
fi

# 5. No hardcoded localhost URLs
while IFS= read -r f; do
    [ -f "$f" ] || continue
    if grep -qE 'https?://localhost' "$f"; then
        red "✖  Hardcoded localhost URL in: $f"
        PASS=false
    fi
done <<< "$STAGED"

# 6. Warn about images over 1 MB
while IFS= read -r f; do
    [[ "$f" =~ \.(png|jpg|jpeg|gif|webp)$ ]] || continue
    [ -f "$f" ] || continue
    size=$(wc -c < "$f")
    if [ "$size" -gt 1048576 ]; then
        kb=$((size / 1024))
        yellow "⚠  Large image (${kb} KB): $f — consider optimizing."
    fi
done <<< "$STAGED"

# 7. Warn about placeholder App Store URL
while IFS= read -r f; do
    [[ "$f" == *.html ]] || continue
    [ -f "$f" ] || continue
    if grep -q 'href="https://apps.apple.com/"' "$f"; then
        yellow "⚠  Placeholder App Store URL in: $f — update to the real app link."
    fi
done <<< "$STAGED"

# 8. Working files must stay unpublished (listed under exclude: in _config.yml)
for item in CLAUDE.md CONTRIBUTING.md content-backlog.md social/ marketing/ skills-lock.json lighthouserc.json lychee.toml; do
    if ! grep -qE "^[[:space:]]*-[[:space:]]+${item//./\\.}[[:space:]]*$" _config.yml; then
        red "✖  _config.yml exclude is missing \"$item\" — it would be published."
        PASS=false
    fi
done

# 9. IndexNow key file must stay in the repo
if ! git ls-files --cached | grep -qE '^[0-9a-f]{32}\.txt$'; then
    red "✖  IndexNow key file (<32 hex chars>.txt at the repo root) is missing."
    PASS=false
fi

# 10. _data/golf_caddie.yml and JSON configs must parse
if command -v ruby &>/dev/null; then
    if ! ruby -ryaml -e 'YAML.load_file(ARGV[0])' _data/golf_caddie.yml 2>/dev/null; then
        red "✖  _data/golf_caddie.yml is not valid YAML."
        PASS=false
    fi
    if [ -f lighthouserc.json ] && ! ruby -rjson -e 'JSON.parse(File.read(ARGV[0]))' lighthouserc.json 2>/dev/null; then
        red "✖  lighthouserc.json is not valid JSON."
        PASS=false
    fi
fi

# 11. Guides: required front matter, and flag hardcoded app facts
while IFS= read -r f; do
    [[ "$f" == apps/golf-caddie/guides/*.md ]] || continue
    [[ "$(basename "$f")" == _* ]] && continue
    [ -f "$f" ] || continue
    for key in title description permalink date last_modified_at; do
        if ! grep -qE "^${key}:[[:space:]]*[^[:space:]\"']" "$f" && ! grep -qE "^${key}:[[:space:]]*[\"'][^\"']" "$f"; then
            red "✖  $f: front matter \"$key\" is missing or empty."
            PASS=false
        fi
    done
    if ! grep -qE '^answer:' "$f"; then
        red "✖  $f: front matter \"answer\" (40–60 word intro) is missing."
        PASS=false
    fi
    if ! grep -qE '^permalink:[[:space:]]*["'"'"']?/apps/golf-caddie/guides/[a-z0-9-]+/["'"'"']?[[:space:]]*$' "$f"; then
        red "✖  $f: permalink must look like /apps/golf-caddie/guides/<slug>/"
        PASS=false
    fi
    if grep -qE 'YYYY|<slug>' "$f"; then
        red "✖  $f: template placeholders (YYYY or <slug>) left in."
        PASS=false
    fi
    hits=$(grep -nE '\$[0-9]+\.[0-9]{2}|6760603837|pt=128660093|iOS [0-9]+\.[0-9]' "$f" || true)
    if [ -n "$hits" ]; then
        yellow "⚠  $f hardcodes app facts. In the body, use {{ site.data.golf_caddie... }} instead:"
        echo "$hits" | sed 's/^/     /'
    fi
done <<< "$STAGED"

# 12. Release reminder when facts or pages change
if echo "$STAGED" | grep -qE '^(_data/golf_caddie\.yml|llms\.txt|apps/golf-caddie/.*\.(html|md))$'; then
    live=$(curl -s --max-time 5 'https://itunes.apple.com/lookup?id=6760603837&country=us' || true)
    version=$(printf '%s' "$live" | sed -nE 's/.*"version":"([^"]+)".*/\1/p')
    site_version=$(sed -nE 's/^app_version:[[:space:]]*"?([^"[:space:]]+)"?.*/\1/p' _data/golf_caddie.yml)
    upcoming=$(sed -nE 's/^upcoming_version:[[:space:]]*"?([^"[:space:]]*)"?.*/\1/p' _data/golf_caddie.yml)
    if [ -n "$version" ] && [ -n "$upcoming" ] && [ "$version" = "$upcoming" ]; then
        yellow "ℹ  v$upcoming is live on the App Store. Release-day flip: set app_version to \"$upcoming\" and upcoming_version to \"\" in _data/golf_caddie.yml."
    elif [ -n "$version" ] && [ -n "$site_version" ] && [ "$version" != "$site_version" ]; then
        yellow "ℹ  _data app_version is v$site_version but the App Store has v$version. Run the release-update skill."
    elif [ -n "$upcoming" ]; then
        yellow "ℹ  Live App Store version: $version. v$upcoming content stays hidden until release day (upcoming_version)."
    elif [ -n "$version" ]; then
        yellow "ℹ  Live App Store version: $version. Only describe features that are in this version."
    else
        yellow "ℹ  Couldn't reach the App Store. Check the live version before describing new features."
    fi
fi

if [ "$PASS" = false ]; then
    echo
    red "Pre-commit checks failed. Fix the errors above and try again."
    exit 1
fi

green "✔  Pre-commit checks passed."
exit 0
